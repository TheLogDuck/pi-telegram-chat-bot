# Core Telegram Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_ID=your_telegram_chat_id_here

# LLM Credentials
GEMINI_API_KEY=your_gemini_token_key_here

# Application Configuration
LOG_LEVEL=INFO
LOG_TO_CONSOLE=false
LOG_TO_FILE=true
LOG_FILE_PATH=bot.log
DATABASE_PATH=bot_data.db

# Testing Infrastructure
TEST_RUNNER_BOT_TOKEN=your_test_runner_token_here
TEST_GROUP_CHAT_ID=your_test_group_id_here

# GCP
GCP_PROJECT_ID=your-project-id
GCP_SERVICE_ACCOUNT_FILE=your_gcp_service_account
GCP_BILLING_TABLE=your-project-id.billing_data.gcp_billing_export_v1_XXXXXX_XXXXXX_XXXXXX